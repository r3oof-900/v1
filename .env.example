# ─── Arjwan Electronics — Environment Variables ───────────────
# Copy this file to .env.local and fill in the values

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Arjwan Electronics

# Mock Mode
ENABLE_MOCK_AUTH=true
ENABLE_MOCK_CHECKOUT=true
ENABLE_DEMO_NOTICE=true

# Payment Provider (mock | moyasar | hyperpay | stripe | tap)
PAYMENT_PROVIDER=mock

# Payment Secrets (not required in mock mode)
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Cloudflare (not required for local dev)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
